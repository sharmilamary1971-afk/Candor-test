errors."],"diff_preview":[],"summary":{"current_phase":"REPORT","start_time":"2026-10-06T15:37:12.934348","total_transitions":2,"invalid_modification_attempts":0,"transitions":[{"from":"ANALYSIS","to":"PLAN","timestamp":"2026-10-06T15:37:13.295313","reason":"Planning fixes"},{"from":"PLAN","to":"REPORT","timestamp":"2026-10-06T15:37:13.346165","reason":"Skipping apply - generating report"}],"modification_attempts":[]},"memory_summary":{"total_applied_changes":0,"total_rejected_fixes":0,"total_patterns":0,"total_risks":0,"total_verifications":0,"blacklisted_files":0,"recent_changes":[],"recent_rejections":[],"recent_verifications":[]},"parsed_data":{"files_reviewed":[],"issues":[],"recommendations":[],"fixes":[]},"debug_result":{"summary":"REPORT","changes":[],"changeCount":0},"response_html":"<style>\n            \n/* ═══════════════════════════════════════════════════════════════ */\n/* CANDOR UI - PROFESSIONAL DESIGN SYSTEM (config-driven)          */\n/* ═══════════════════════════════════════════════════════════════ */\n\n:root {\n    /* ─────────────── Typography Scale ─────────────── */\n    --text-xs: 0.75rem;      /* 12px - Badges, metadata */\n    --text-sm: 14px;\n    --text-primary: #E5E5E5;\n    --text-primary-blend: #E5E5E5;\n    --text-secondary: #E0E0E0;\n    --text-muted: #AAAAAA;\n    --text-desc-blend: #E5E5E5;\n    --accent-blue: #3794ff;\n    --text-base: 1rem;       /* 16px - Normal text */\n    --text-lg: 1.125rem;     /* 18px - Section headings */\n    --text-xl: 1.25rem;      /* 20px - Main headings */\n    --text-2xl: 1.5rem;      /* 24px - Page titles */\n    \n    /* ─────────────── Spacing Scale ─────────────── */\n    --space-1: 0.25rem;      /* 4px */\n    --space-2: 0.5rem;       /* 8px */\n    --space-3: 0.75rem;      /* 12px */\n    --space-4: 1rem;         /* 16px */\n    --space-5: 1.25rem;      /* 20px */\n    --space-6: 1.5rem;       /* 24px */\n    --space-8: 2rem;         /* 32px */\n    \n    /* ─────────────── Color Palette: dark native + blended chat ─────────────── */\n    --bg-primary: #1e1e1e;\n    --bg-primary-blend: linear-gradient(180deg, #252528 0%, #1e1e21 50%, #1a1a1d 100%);\n    --bg-secondary: #252526;\n    --bg-tertiary: #2d2d30;\n    \n    --border-subtle: #21262D;\n    --border-default: #30363D;\n    --border-muted: #484F58;\n    \n\n    --accent-green: #3FB950;\n    --accent-red: #F85149;\n    --accent-yellow: #D29922;\n    --accent-purple: #BC8CFF;\n    \n    /* ─────────────── Border Radius ─────────────── */\n    --radius-sm: 3px;\n    --radius-md: 6px;\n    --radius-lg: 8px;\n    \n    /* ─────────────── Shadows ─────────────── */\n    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12);\n    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.15);\n    --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.18);\n    \n    /* ─────────────── Line Heights ─────────────── */\n    --leading-tight: 1.2;\n    --leading-compact: 1.35;\n    --leading-normal: 1.5;\n    --leading-relaxed: 1.6;\n    \n    /* ─────────────── Font Weights ─────────────── */\n    --font-normal: 400;\n    --font-medium: 500;\n    --font-semibold: 600;\n    --font-bold: 700;\n    /* Editor font: use host editor font when available so chat matches IDE */\n    /* Match user prompt / chat default: use same font as chat panel (--vscode-font-family) */\n    --candor-font-ui: var(--vscode-font-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif);\n    /* Host (Chat UI) often wraps our HTML with padding; cancel it so content is flush left */\n    --candor-host-padding-offset: 16px;\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* GLOBAL STYLES - COMPACT RICH LAYOUT                             */\n/* ═══════════════════════════════════════════════════════════════ */\n\n/* Chat panel: use same font as user prompt / default chat text */\n.candor-ui-container {\n    font-family: var(--candor-font-ui);\n    font-size: var(--vscode-font-size, 14px);\n    color: var(--text-desc-blend);\n    background: var(--bg-primary-blend);\n    font-weight: var(--font-normal);\n    line-height: 1.55;\n    padding: var(--space-4) var(--space-4);\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    gap: var(--space-4);\n    border-radius: var(--radius-lg);\n    border: 1px solid var(--border-default);\n    box-sizing: border-box;\n    text-align: left;\n    align-items: stretch;\n    max-width: 100%;\n    width: 100%;\n}\n\n.candor-ui-container * {\n    box-sizing: border-box;\n}\n\n/* Section blocks: compact vertical space */\n.candor-ui-container .candor-response-analysis,\n.candor-ui-container .candor-findings,\n.candor-ui-container .candor-analysis,\n.candor-ui-container .candor-suggestions {\n    margin: 0;\n    padding: var(--space-2) 0;\n    text-align: left;\n    background: transparent;\n    border: none;\n    border-radius: 0;\n    box-shadow: none;\n    width: 100%;\n    line-height: 1.55;\n}\n\n.candor-ui-container .candor-file-container {\n    margin: var(--space-3) 0;\n    padding: var(--space-3) 0;\n    margin-left: 0;\n    margin-right: 0;\n    width: 100%;\n    text-align: left;\n    border-top: 1px solid var(--border-subtle);\n}\n\n/* Section header - blended */\n.candor-section-header {\n    font-size: var(--text-base);\n    font-weight: var(--font-semibold);\n    color: var(--text-primary-blend);\n    margin: 0 0 2px 0;\n    padding: 0;\n    border-bottom: none;\n    letter-spacing: 0.02em;\n    text-align: left;\n}\n\n.empty-response {\n    padding: var(--space-2);\n    color: var(--text-muted);\n    font-style: italic;\n    font-size: var(--text-sm);\n    border-radius: 0;\n    border: none;\n}\n\n.candor-ui-container > div {\n    min-width: 0; /* Prevent flex overflow */\n}\n\n/* Section blocks - compact, left-aligned */\n.candor-response-analysis,\n.candor-findings,\n.candor-analysis,\n.candor-suggestions {\n    margin: 0;\n    padding: var(--space-1) 0;\n    text-align: left;\n    background: transparent;\n    border: none;\n    border-radius: 0;\n    box-shadow: none;\n    display: block;\n    width: 100%;\n}\n/* Findings heading explicitly left-aligned */\n.candor-findings,\n.candor-findings strong {\n    text-align: left;\n}\n\n/* Suggestions / Summary: readable size, editor font, native blend */\n.candor-suggestions strong,\n.candor-ui-container .candor-chat-heading {\n    font-size: var(--text-sm);\n    font-weight: var(--font-bold);\n    color: var(--text-primary-blend);\n}\n.candor-suggestions .candor-chat-desc,\n.candor-ui-container .candor-chat-desc {\n    font-size: var(--text-sm);\n    font-weight: var(--font-normal);\n    color: var(--text-desc-blend);\n}\n.candor-ui-container [style*=\"border-left: 2px solid\"],\n.candor-suggestions div {\n    word-wrap: break-word;\n    overflow-wrap: break-word;\n    white-space: normal;\n    max-width: 100%;\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* TYPOGRAPHY COMPONENTS                                           */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-heading-xl {\n    font-size: var(--text-lg);\n    font-weight: var(--font-bold);\n    color: var(--text-primary);\n    margin: 0 0 var(--space-1) 0;\n    line-height: var(--leading-tight);\n    text-align: left;\n}\n\n.candor-heading-lg {\n    font-size: var(--text-base);\n    font-weight: var(--font-semibold);\n    color: var(--text-primary);\n    margin: 0 0 var(--space-1) 0;\n    line-height: var(--leading-tight);\n    text-align: left;\n}\n\n.candor-text-sm {\n    font-size: var(--text-sm);\n    color: var(--text-secondary);\n    line-height: var(--leading-normal);\n    text-align: left;\n    font-weight: var(--font-normal);\n}\n\n.candor-text-xs {\n    font-size: var(--text-xs);\n    color: var(--text-muted);\n    line-height: var(--leading-tight);\n    text-align: left;\n    font-weight: var(--font-normal);\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* CARD COMPONENTS                                                 */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-card {\n    background: transparent;\n    border: none;\n    border-radius: 0;\n    padding: var(--space-2);\n    margin: var(--space-1) 0;\n    box-shadow: none;\n}\n\n.candor-card-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding-bottom: var(--space-2);\n    margin-bottom: var(--space-2);\n    border-bottom: none;\n}\n\n.candor-card-body {\n    padding: var(--space-1) 0;\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* BOX-DRAWING BORDERS                                             */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-box-top {\n    font-family: 'Consolas', 'Monaco', monospace;\n    color: var(--border-muted);\n    font-size: var(--text-sm);\n    margin: var(--space-1) 0;\n}\n\n.candor-box-bottom {\n    font-family: 'Consolas', 'Monaco', monospace;\n    color: var(--border-muted);\n    font-size: var(--text-sm);\n    margin: var(--space-1) 0;\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* CODE BLOCKS                                                     */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-code-block {\n    background: var(--bg-tertiary);\n    border: none;\n    border-radius: 0;\n    padding: var(--space-2);\n    margin: var(--space-1) 0;\n    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;\n    font-size: var(--text-sm);\n    line-height: var(--leading-relaxed);\n    overflow-x: auto;\n}\n\n.candor-code-block-removed {\n    background: rgba(248, 81, 73, 0.08);\n    border-left: 3px solid var(--accent-red);\n}\n\n.candor-code-block-added {\n    background: rgba(63, 185, 80, 0.08);\n    border-left: 3px solid var(--accent-green);\n}\n\n.candor-code-line {\n    display: flex;\n    gap: var(--space-3);\n    padding: var(--space-1) 0;\n}\n\n.candor-code-line-marker {\n    width: 1.5em;\n    text-align: center;\n    font-weight: var(--font-bold);\n    flex-shrink: 0;\n}\n\n.candor-code-line-marker-remove {\n    color: var(--accent-red);\n}\n\n.candor-code-line-marker-add {\n    color: var(--accent-green);\n}\n\n.candor-code-line-content {\n    flex: 1;\n    white-space: pre-wrap;\n    word-break: break-all;\n    color: var(--text-primary);\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* RESPONSE ANALYSIS BLOCK                                         */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-response-analysis {\n    font-size: var(--text-sm);\n    line-height: var(--leading-compact);\n}\n\n.candor-response-analysis h1,\n.candor-response-analysis h2,\n.candor-response-analysis h3,\n.candor-response-analysis h4,\n.candor-response-analysis h5,\n.candor-response-analysis h6 {\n    font-size: var(--text-sm);\n    font-weight: var(--font-semibold);\n    margin: var(--space-1) 0;\n    text-align: left;\n}\n\n.candor-response-analysis p {\n    margin: 8px 0;\n    font-weight: var(--font-normal);\n    text-align: left;\n    line-height: 1.6;\n}\n\n/* What's fixed — one line per fix, readable spacing */\n.candor-what-fixed {\n    margin: var(--space-2) 0 var(--space-3) 0;\n    padding: var(--space-2) 0 0 0;\n    font-size: var(--text-sm);\n    color: var(--text-secondary);\n    line-height: 1.55;\n    text-align: left;\n}\n.candor-what-fixed-label {\n    display: block;\n    font-weight: var(--font-semibold);\n    color: var(--text-muted);\n    margin-bottom: var(--space-2);\n    font-size: var(--text-sm);\n}\n.candor-what-fixed-list {\n    margin: 0;\n    padding: 0 0 0 var(--space-5);\n    list-style: disc;\n}\n.candor-what-fixed-list li {\n    margin: 0 0 var(--space-2) 0;\n    line-height: 1.55;\n    white-space: normal;\n    word-break: normal;\n    overflow-wrap: break-word;\n}\n.candor-what-fixed-list li:last-child {\n    margin-bottom: 0;\n}\n\n.candor-file-header-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    padding: var(--space-1) 0 var(--space-2) 0;\n    margin-bottom: var(--space-1);\n    background: transparent;\n    border-bottom: none;\n    cursor: pointer;\n    flex-wrap: nowrap;\n    width: 100%;\n    min-width: 0;\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* BUTTONS                                                         */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-btn {\n    height: 32px;\n    padding: 0 var(--space-4);\n    font-size: var(--text-sm);\n    font-weight: var(--font-normal);\n    border-radius: var(--radius-md);\n    border: none;\n    cursor: pointer;\n    transition: all 0.15s ease;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: var(--space-2);\n}\n\n.candor-btn-primary {\n    background: var(--accent-blue);\n    color: white;\n}\n\n.candor-btn-primary:hover {\n    background: #478ed0;\n    box-shadow: var(--shadow-md);\n    transform: translateY(-1px);\n}\n\n.candor-btn-success {\n    background: var(--accent-green);\n    color: white;\n}\n\n.candor-btn-success:hover {\n    background: #2ea043;\n    box-shadow: var(--shadow-md);\n    transform: translateY(-1px);\n}\n\n.candor-btn-danger {\n    background: var(--accent-red);\n    color: white;\n}\n\n.candor-btn-danger:hover {\n    background: #da3633;\n    box-shadow: var(--shadow-md);\n    transform: translateY(-1px);\n}\n\n.candor-btn:active {\n    transform: translateY(0);\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* FILE CONTAINER                                                  */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-file-container {\n    background: transparent;\n    border: none;\n    border-radius: 0;\n    padding: var(--space-1) 0;\n    margin: var(--space-1) 0;\n    box-shadow: none;\n    width: 100%;\n    text-align: left;\n}\n\n/* File row: single line, filename + stats left, buttons right, no large gap */\n.candor-file-header-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: var(--space-2);\n    flex-wrap: nowrap;\n    width: 100%;\n    min-width: 0;\n    padding: 2px 0;\n    margin: 0;\n    background: transparent;\n    border-bottom: none;\n    cursor: pointer;\n}\n.candor-file-header-top .candor-file-click,\n.candor-file-header-top .file-arrow {\n    flex-shrink: 0;\n}\n.candor-file-header-top > div:last-child {\n    flex-shrink: 0;\n    margin-left: auto;\n}\n\n.candor-file-name {\n    color: var(--accent-green);\n    font-weight: var(--font-semibold);\n    font-size: var(--text-base);\n    cursor: pointer;\n    text-decoration: underline;\n}\n\n.candor-file-name:hover {\n    color: #4ac26b;\n}\n\n.candor-file-stats {\n    display: flex;\n    align-items: center;\n    gap: var(--space-3);\n    font-size: var(--text-xs);\n    color: var(--text-muted);\n}\n\n.candor-file-badge {\n    background: var(--bg-tertiary);\n    padding: var(--space-1) var(--space-2);\n    border-radius: 0;\n    border: none;\n    font-family: 'Consolas', 'Monaco', monospace;\n    font-weight: var(--font-normal);\n}\n\n.candor-file-badge-added {\n    color: var(--accent-green);\n}\n\n.candor-file-badge-removed {\n    color: var(--accent-red);\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* HUNK CONTAINER                                                  */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-hunk {\n    margin: var(--space-1) 0;\n}\n\n.candor-hunk-title {\n    font-size: var(--text-sm);\n    font-weight: var(--font-semibold);\n    color: var(--accent-blue);\n    margin-bottom: var(--space-1);\n    text-align: left;\n}\n\n.candor-hunk-wrapper {\n    border: none;\n    border-radius: 0;\n    overflow: hidden;\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* DISCOVERY STATS                                                 */\n/* ═══════════════════════════════════════════════════════════════ */\n\n.candor-discovery-stats {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: var(--space-2);\n    padding: var(--space-1) 0;\n    background: transparent;\n    border: none;\n    border-radius: 0;\n    margin: var(--space-2) 0;\n    box-shadow: none;\n    width: 100%;\n    text-align: left;\n}\n\n.candor-stat-item {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    text-align: left;\n}\n\n.candor-stat-icon {\n    font-size: var(--text-2xl);\n    margin-bottom: var(--space-1);\n}\n\n.candor-stat-label {\n    font-size: var(--text-xs);\n    color: var(--text-muted);\n    margin-bottom: 2px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    font-weight: var(--font-normal);\n}\n\n.candor-stat-value {\n    font-size: var(--text-lg);\n    font-weight: var(--font-normal);\n    color: var(--accent-blue);\n}\n\n/* ═══════════════════════════════════════════════════════════════ */\n/* ANIMATIONS                                                      */\n/* ═══════════════════════════════════════════════════════════════ */\n\n@keyframes fadeInSlideDown {\n    from {\n        opacity: 0;\n        transform: translateY(-8px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n.candor-fade-in {\n    animation: fadeInSlideDown 0.3s ease-out;\n}\n\n            /**\n * Candor Diff & Highlight Styles - Hunk-Based Edition\n * Production-grade CSS for unified diff hunks with accessibility & theme support\n */\n\n:root {\n  /* Light theme */\n  --diff-removed-bg: rgba(248, 81, 73, 0.1);\n  --diff-removed-border: #F85149;\n  --diff-removed-text: #D4D4D4;\n  \n  --diff-added-bg: rgba(63, 185, 80, 0.1);\n  --diff-added-border: #3FB950;\n  --diff-added-text: #D4D4D4;\n  \n  --diff-bg: rgba(13, 17, 23, 0.5);\n  --diff-text: #D4D4D4;\n  --diff-border: rgba(106, 153, 85, 0.3);\n  \n  /* Hunk-specific */\n  --hunk-header-bg: rgba(200, 200, 200, 0.1);\n  --hunk-header-text: #666;\n  --hunk-border: rgba(200, 200, 200, 0.3);\n  --line-number-text: #999;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --diff-removed-bg: rgba(248, 81, 73, 0.08);\n    --diff-removed-border: #F85149;\n    --diff-removed-text: #E6EDF3;\n    \n    --diff-added-bg: rgba(63, 185, 80, 0.08);\n    --diff-added-border: #3FB950;\n    --diff-added-text: #E6EDF3;\n    \n    --diff-bg: rgba(13, 17, 23, 0.8);\n    --diff-text: #E6EDF3;\n    --diff-border: rgba(48, 54, 61, 0.6);\n    \n    /* Hunk-specific */\n    --hunk-header-bg: rgba(48, 54, 61, 0.4);\n    --hunk-header-text: #8B949E;\n    --hunk-border: rgba(48, 54, 61, 0.8);\n    --line-number-text: #6E7681;\n  }\n}\n\n@media (prefers-color-scheme: light) {\n  :root {\n    --diff-removed-bg: rgba(248, 81, 73, 0.15);\n    --diff-removed-border: #D1242F;\n    --diff-removed-text: #24292E;\n    \n    --diff-added-bg: rgba(63, 185, 80, 0.15);\n    --diff-added-border: #28A745;\n    --diff-added-text: #24292E;\n    \n    --diff-bg: rgba(245, 245, 245, 0.6);\n    --diff-text: #24292E;\n    --diff-border: rgba(200, 200, 200, 0.6);\n    \n    /* Hunk-specific */\n    --hunk-header-bg: rgba(200, 200, 200, 0.15);\n    --hunk-header-text: #555;\n    --hunk-border: rgba(200, 200, 200, 0.5);\n    --line-number-text: #AAA;\n  }\n}\n\n/* Container for entire diff - Cursor plan style, no border */\n.candor-diff-container {\n  margin: 0.05em 0;\n  padding: 0;\n  background: var(--diff-bg);\n  border-radius: 0;\n  border: none;\n  overflow: auto;\n  font-family: 'Consolas', 'Monaco', 'Courier New', monospace;\n}\n\n/* Removed code block */\n.candor-diff-removed {\n  padding: 0.2em 0.4em;\n  background: var(--diff-removed-bg);\n  border-left: 2px solid var(--diff-removed-border);\n  color: var(--diff-removed-text);\n  font-size: 0.8em;\n  white-space: pre-wrap;\n  word-break: break-all;\n  line-height: 1.25;\n  position: relative;\n}\n\n.candor-diff-removed::before {\n  content: '− ';\n  color: var(--diff-removed-border);\n  font-weight: bold;\n  margin-right: 0.2em;\n}\n\n/* Added code block */\n.candor-diff-added {\n  padding: 0.2em 0.4em;\n  background: var(--diff-added-bg);\n  border-left: 2px solid var(--diff-added-border);\n  color: var(--diff-added-text);\n  font-size: 0.8em;\n  white-space: pre-wrap;\n  word-break: break-all;\n  line-height: 1.25;\n  position: relative;\n}\n\n.candor-diff-added::before {\n  content: '+ ';\n  color: var(--diff-added-border);\n  font-weight: bold;\n  margin-right: 0.2em;\n}\n\n/* Line number styling */\n.candor-line-number {\n  display: inline-block;\n  color: rgba(128, 128, 128, 0.6);\n  margin-right: 0.5em;\n  font-weight: 500;\n  user-select: none;\n  min-width: 2em;\n  text-align: right;\n}\n\n/* Truncation indicator */\n.candor-diff-truncated {\n  padding: 0.2em 0.4em;\n  color: rgba(128, 128, 128, 0.7);\n  font-size: 0.75em;\n  font-style: italic;\n  border-left: 2px solid rgba(128, 128, 128, 0.3);\n}\n\n/* Syntax highlighting classes */\n.hljs {\n  background: transparent;\n  color: var(--diff-text);\n}\n\n.hljs-string {\n  color: #CE9178;\n}\n\n.hljs-number {\n  color: #B5CEA8;\n}\n\n.hljs-literal {\n  color: #569CD6;\n}\n\n.hljs-attr {\n  color: #9CDCFE;\n}\n\n.hljs-title {\n  color: #4EC9B0;\n}\n\n.hljs-type {\n  color: #4EC9B0;\n}\n\n.hljs-class {\n  color: #4EC9B0;\n}\n\n.hljs-function {\n  color: #DCDCAA;\n}\n\n.hljs-keyword {\n  color: #569CD6;\n}\n\n.hljs-comment {\n  color: #6A9955;\n}\n\n.hljs-symbol {\n  color: #D7BA7D;\n}\n\n.hljs-variable {\n  color: #9CDCFE;\n}\n\n/* Accessibility - Skip link for screen readers */\n.candor-diff-sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n/* Responsive adjustments */\n@media (max-width: 768px) {\n  .candor-diff-removed,\n  .candor-diff-added {\n    font-size: 0.7em;\n    padding: 0.2em 0.3em;\n  }\n  \n  .candor-line-number {\n    font-size: 0.65em;\n  }\n}\n\n/* ==================== HUNK-BASED STYLES ==================== */\n\n/* Diff statistics header - Cursor style, no border */\n.candor-diff-stats {\n  display: flex;\n  gap: 0.75rem;\n  padding: 0.35rem 0.6rem;\n  background: var(--hunk-header-bg);\n  border: none;\n  border-radius: 0;\n  margin-bottom: 0.4rem;\n  font-size: 0.85rem;\n}\n\n.candor-diff-stat-item {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.candor-diff-stat-label {\n  font-weight: 600;\n  color: var(--hunk-header-text);\n}\n\n.candor-diff-stat-value {\n  font-family: 'Courier New', monospace;\n  font-weight: bold;\n  color: var(--diff-text);\n  min-width: 2rem;\n}\n\n.candor-diff-added-stat .candor-diff-stat-value {\n  color: var(--diff-added-border);\n}\n\n.candor-diff-removed-stat .candor-diff-stat-value {\n  color: var(--diff-removed-border);\n}\n\n/* Per-fix diff: compact vertical space */\n.candor-diff-stats-inline {\n  font-size: var(--text-xs, 0.75rem);\n  color: var(--text-muted, #888);\n  margin: 0 0 2px 0;\n  padding: 0;\n  font-family: Consolas, Monaco, monospace;\n  line-height: 1.25;\n}\n\n.candor-diff-compact .candor-hunk-container {\n  margin-bottom: 0;\n}\n\n/* One card per file: hunks flow together inside file container (no sub-card look) */\n.candor-file-container .candor-hunk-container {\n  margin-bottom: 0;\n  border: none;\n  border-radius: 0;\n  background: transparent;\n  box-shadow: none;\n}\n.candor-file-container .candor-hunk-container:focus-within {\n  box-shadow: none;\n}\n.candor-file-container .candor-hunk-header {\n  padding: 2px 6px;\n  margin: 0;\n  font-size: 0.7rem;\n  border-radius: 0;\n  background: rgba(0,0,0,0.2);\n  line-height: 1.25;\n}\n/* Diff region: compact */\n.candor-file-container .candor-diff-region {\n  background: var(--bg-primary);\n  border-radius: 2px;\n  overflow-x: auto;\n  font-size: 0.85rem;\n  line-height: 1.25;\n  padding: 0;\n  margin: 0;\n  text-align: left;\n}\n\n/* File card: reduced vertical space */\n.candor-file-container .candor-file-header-top {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 6px;\n  padding: 4px 0;\n  margin: 0;\n  text-align: left;\n}\n.candor-file-container .candor-what-fixed {\n  padding: 2px 0;\n  margin: 0;\n  line-height: 1.25;\n  text-align: left;\n}\n.candor-file-container .candor-diff-file-content,\n.candor-file-container [class^=\"file-content-\"] {\n  padding: 2px 0 0 0;\n  margin: 0;\n  text-align: left;\n}\n.candor-file-container .candor-diff-stats-inline {\n  margin: 0 0 2px 0;\n  padding: 0;\n  text-align: left;\n  line-height: 1.25;\n}\n.candor-file-container .candor-hunk-wrapper {\n  margin: 0;\n  padding: 0;\n}\n\n/* Hunk container - compact */\n.candor-hunk-container {\n  margin-bottom: 2px;\n  border: none;\n  border-radius: 0;\n  overflow: hidden;\n  background: var(--diff-bg);\n}\n\n.candor-hunk-container:focus-within {\n  box-shadow: none;\n}\n\n/* Hunk header: compact */\n.candor-hunk-header {\n  background: var(--hunk-header-bg);\n  color: var(--hunk-header-text);\n  padding: 2px 6px;\n  margin: 0;\n  font-family: 'Courier New', monospace;\n  font-size: 0.75rem;\n  font-weight: 600;\n  border-bottom: none;\n  user-select: none;\n  line-height: 1.25;\n}\n\n.candor-hunk-header:hover {\n  background: rgba(100, 100, 100, 0.15);\n}\n\n/* Hunk body - contains diff lines */\n.candor-hunk-body {\n  background: var(--diff-bg);\n}\n\n/* Individual diff line - compact */\n.candor-diff-line {\n  display: flex;\n  align-items: flex-start;\n  font-family: 'Courier New', 'Monaco', monospace;\n  font-size: 0.82rem;\n  line-height: 1.25;\n  padding: 0;\n  margin: 0;\n  border-left: 3px solid transparent;\n}\n\n/* Context line (unchanged) */\n.candor-diff-context-line {\n  background: var(--diff-bg);\n  color: var(--diff-text);\n  border-left-color: var(--diff-border);\n}\n\n/* Removed line (old content) */\n.candor-diff-removed-line {\n  background: var(--diff-removed-bg);\n  color: var(--diff-removed-text);\n  border-left-color: var(--diff-removed-border);\n}\n\n.candor-diff-removed-line:hover {\n  background: rgba(248, 81, 73, 0.15);\n}\n\n/* Added line (new content) */\n.candor-diff-added-line {\n  background: var(--diff-added-bg);\n  color: var(--diff-added-text);\n  border-left-color: var(--diff-added-border);\n}\n\n.candor-diff-added-line:hover {\n  background: rgba(63, 185, 80, 0.15);\n}\n\n/* Line numbers column - minimal horizontal padding */\n.candor-line-number {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n  min-width: 2.25rem;\n  padding: 0 0.15rem;\n  color: var(--line-number-text);\n  font-size: 0.7rem;\n  user-select: none;\n  border-right: none;\n  margin-right: 0.15rem;\n}\n\n.candor-line-number-old {\n  border-right: none;\n}\n\n.candor-line-number-new {\n  border-right: none;\n}\n\n/* Diff prefix (-, +, space) */\n.candor-diff-prefix {\n  display: inline-block;\n  width: 1.5rem;\n  text-align: center;\n  font-weight: bold;\n  user-select: none;\n}\n\n.candor-diff-removed-line .candor-diff-prefix {\n  color: var(--diff-removed-border);\n}\n\n.candor-diff-added-line .candor-diff-prefix {\n  color: var(--diff-added-border);\n}\n\n/* Line content - minimal horizontal padding */\n.candor-diff-content {\n  flex: 1;\n  white-space: pre-wrap;\n  word-break: break-word;\n  padding: 0 0.15rem;\n}\n\n/* Empty diff message - Cursor style, no border */\n.candor-diff-empty {\n  padding: 0.25rem;\n  text-align: center;\n  color: var(--line-number-text);\n  font-style: italic;\n  background: var(--diff-bg);\n  border: none;\n  border-radius: 0;\n}\n\n/* Focus states for keyboard navigation - minimal */\n.candor-diff-container:focus-within {\n  outline: none;\n}\n\n.candor-diff-line:focus-within {\n  background-color: rgba(74, 144, 226, 0.1);\n}\n\n/* Print styles */\n@media print {\n  .candor-diff-container {\n    page-break-inside: avoid;\n  }\n  \n  .candor-diff-removed {\n    background: #FFE0E0;\n    border-left-color: #FF0000;\n  }\n  \n  .candor-diff-added {\n    background: #E0FFE0;\n    border-left-color: #00AA00;\n  }\n}\n        </style>\n        <div class=\"candor-ui-container candor-final-response\" style=\"font-family: var(--candor-font-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif); font-size: var(--text-sm, 14px); line-height: 1.4; color: var(--text-desc-blend, #E5E5E5); background: var(--bg-primary-blend, #1e1e1e); padding: var(--space-2, 8px) var(--space-3, 12px); margin: 0; text-align: left; box-sizing: border-box; max-width: 100%;\"><div style=\"\n            margin: 0 0 var(--space-1) 0;\n            padding: 0;\n            font-family: var(--candor-font-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);\n            color: var(--text-desc-blend, #E5E5E5);\n            font-size: var(--text-sm, 14px);\n            line-height: 1.4;\n            border: none;\n            background: transparent;\n            text-align: left;\n            font-weight: 400;\n        \">Reviewed the selected files and found no issues.</div>\n<div class=\"candor-findings\" style=\"\n            margin: 0 0 var(--space-1) 0;\n            padding: 0;\n            font-family: var(--candor-font-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);\n            background: transparent;\n            border: none;\n            font-size: var(--text-sm, 14px);\n            color: var(--text-desc-blend, #E5E5E5);\n            line-height: 1.4;\n            text-align: left;\n            font-weight: 400;\n            max-width: 100%;\n            min-width: 0;\n            overflow-wrap: anywhere;\n            word-break: break-word;\n            white-space: normal;\n          